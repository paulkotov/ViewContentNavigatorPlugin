<Window x:Class="ViewContentNavigator.Views.NavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ViewContentNavigator.Views.Converters"
        xmlns:models="clr-namespace:ViewContentNavigator.Models"
        Title="Элементы вида"
        Width="440" Height="640"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="#FFFFFFFF"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="#FF202124">

    <Window.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F3F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE8EAED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFDADCE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF202124" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF8F9FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F3F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="16" Height="16"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#33000000"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1A73E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF1A73E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F3F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE1E4E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.16" Color="#FF000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0,0,0" />
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          Margin="2,0,8,0"
                          IsThreeState="False"
                          Focusable="False"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Показать / скрыть в виде" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding Count, Mode=OneWay, StringFormat=' ({0})'}" Foreground="#FF80868B" />
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                    <ToggleButton Style="{StaticResource RowToggle}"
                                  x:Name="ColorButton"
                                  IsChecked="{Binding IsColorEditorOpen, Mode=TwoWay}"
                                  ToolTip="Цвет">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Hover" Background="Transparent" CornerRadius="4" Width="24" Height="24">
                                    <Border Width="14" Height="14"
                                            CornerRadius="3"
                                            BorderThickness="1"
                                            BorderBrush="#FFC5CAD0"
                                            Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Path x:Name="EmptyMark"
                                              Data="M2.2,11.2 L11.2,2.2"
                                              Stroke="#FFB0B6BC"
                                              StrokeThickness="1.2"
                                              StrokeStartLineCap="Round"
                                              Stretch="Fill"
                                              Margin="2" />
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                        <Setter TargetName="EmptyMark" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#FFF1F3F4" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#FFE8F0FE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsColorEditorOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ColorButton}"
                           Placement="Bottom"
                           HorizontalOffset="-120"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           DataContext="{Binding}">
                        <Border Style="{StaticResource FlyoutCard}" Width="148">
                            <StackPanel>
                                <TextBlock Text="Цвет"
                                           FontSize="11"
                                           Foreground="#FF80868B"
                                           Margin="2,0,0,6" />
                                <ItemsControl ItemsSource="{x:Static models:PaletteColor.DefaultPalette}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}"
                                                    ToolTip="{Binding Name}"
                                                    Background="{Binding Converter={StaticResource ColorToBrush}}"
                                                    Command="{Binding DataContext.ApplyPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Свой…"
                                            Style="{StaticResource FlyoutTextButton}"
                                            Command="{Binding PickCustomColorCommand}"
                                            ToolTip="Выбрать произвольный цвет" />
                                    <Button Content="Сбросить"
                                            Style="{StaticResource FlyoutTextButton}"
                                            Command="{Binding ClearColorCommand}"
                                            ToolTip="Убрать переопределение цвета" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton Style="{StaticResource RowToggle}"
                                  x:Name="OpacityButton"
                                  MinWidth="24"
                                  Width="Auto"
                                  Padding="3,0"
                                  IsChecked="{Binding IsOpacityEditorOpen, Mode=TwoWay}"
                                  ToolTip="Прозрачность">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Hover"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        MinWidth="24"
                                        Height="24"
                                        Padding="3,0">
                                    <Grid MinWidth="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid x:Name="Icon" Width="14" Height="14">
                                            <Path Stroke="#FF5F6368"
                                                  StrokeThickness="1.2"
                                                  Fill="#FF5F6368"
                                                  Stretch="None"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Data="M7,1.2 A5.8,5.8 0 0 0 7,12.8 Z" />
                                            <Path Stroke="#FF5F6368"
                                                  StrokeThickness="1.2"
                                                  Stretch="None"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Data="M7,1.2 A5.8,5.8 0 0 1 7,12.8" />
                                        </Grid>
                                        <TextBlock x:Name="Value"
                                                   Text="{Binding Opacity, StringFormat={}{0}%}"
                                                   Visibility="Collapsed"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF1A73E8"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomOpacity}" Value="True">
                                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Value" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#FFF1F3F4" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#FFE8F0FE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsOpacityEditorOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=OpacityButton}"
                           Placement="Bottom"
                           HorizontalOffset="-168"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Style="{StaticResource FlyoutCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="Прозрачность"
                                           FontSize="11"
                                           Foreground="#FF80868B"
                                           Margin="0,0,0,6" />
                                <Slider Minimum="0"
                                        Maximum="100"
                                        TickFrequency="25"
                                        IsSnapToTickEnabled="False"
                                        AutoToolTipPlacement="TopLeft"
                                        AutoToolTipPrecision="0"
                                        Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="0%" FontSize="11" Foreground="#FF80868B" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Opacity, StringFormat={}{0}%}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#FF1A73E8" />
                                    <TextBlock Grid.Column="2" Text="100%" FontSize="11" Foreground="#FF80868B" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="ItemContainerStyle" Value="{DynamicResource TreeItemStyle}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisibleInTree, Converter={StaticResource BoolToVis}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0" Grid.Column="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Canvas Width="16" Height="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                <Path x:Name="Arrow"
                                                      Data="M6,4 L10,8 L6,12"
                                                      Stroke="#FF80868B"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M4,6 L8,10 L12,6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Bd"
                                    Grid.Row="0" Grid.Column="1"
                                    MinHeight="28"
                                    Padding="2,2,4,2"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF6F7F8" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE8F1FE" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F3F4" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12,10">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ViewName}">
                <Run Text="Вид" FontWeight="SemiBold" />
                <Run Text="{Binding ViewName, Mode=OneWay, StringFormat=' {0}'}" Foreground="#FF5F6368" />
            </TextBlock>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Style="{StaticResource QuietButton}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Пересканировать вид и применить текущие настройки видимости и цвета" />
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="32" CornerRadius="8" Background="White" Margin="0,0,8,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFE1E4E8" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#FF1A73E8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="#FF9AA0A6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="FilterBox"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <TextBlock Grid.Column="1"
                               Text="Поиск"
                               Foreground="#FF9AA0A6"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="0,0,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2"
                            Width="24" Height="24"
                            Margin="0,0,4,0"
                            Focusable="False"
                            Cursor="Hand"
                            ToolTip="Очистить поиск"
                            Command="{Binding ClearFilterCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Data="M4,4 L10,10 M10,4 L4,10"
                                                      Stroke="#FF80868B"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      Width="12" Height="12"
                                                      Stretch="None"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip="Развернуть">
                    <Path Data="M2,4.2 L8,9.2 L14,4.2 M2,8.6 L8,13.6 L14,8.6"
                          Stroke="#FF3C4043"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="15" Height="15"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip="Свернуть">
                    <Path Data="M2,6.4 L8,1.4 L14,6.4 M2,11.6 L8,6.6 L14,11.6"
                          Stroke="#FF3C4043"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="15" Height="15"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding SelectAllCommand}"
                        ToolTip="Выбрать все">
                    <Grid Width="15" Height="15">
                        <Path Stroke="#FF3C4043"
                              StrokeThickness="1.3"
                              Stretch="None"
                              Data="M3.4,2.6 H11.2 A1.3,1.3 0 0 1 12.5,3.9 V11.6 A1.3,1.3 0 0 1 11.2,12.9 H3.4 A1.3,1.3 0 0 1 2.1,11.6 V3.9 A1.3,1.3 0 0 1 3.4,2.6 Z" />
                        <Path Stroke="#FF3C4043"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None"
                              Data="M4.4,7.6 L6.5,9.7 L10.8,5.2" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding DeselectAllCommand}"
                        ToolTip="Отключить все">
                    <Grid Width="15" Height="15">
                        <Path Stroke="#FF3C4043"
                              StrokeThickness="1.3"
                              Stretch="None"
                              Data="M3.4,2.6 H11.2 A1.3,1.3 0 0 1 12.5,3.9 V11.6 A1.3,1.3 0 0 1 11.2,12.9 H3.4 A1.3,1.3 0 0 1 2.1,11.6 V3.9 A1.3,1.3 0 0 1 3.4,2.6 Z" />
                        <Path Stroke="#FF3C4043"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              Stretch="None"
                              Data="M4.6,7.8 H10.2" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
            <CheckBox Content="Экземпляры"
                      IsChecked="{Binding ShowInstances, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      Foreground="#FF3C4043"
                      ToolTip="Показывать отдельные экземпляры под семействами" />
            <CheckBox Content="Авто"
                      IsChecked="{Binding AutoApply, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Foreground="#FF3C4043"
                      ToolTip="Применять изменения к виду сразу. Если выключено — изменения применяются по кнопке «Обновить»." />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#FF5F6368"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding HiddenCount, StringFormat='скрыто: {0}'}"
                           Foreground="#FF80868B"
                           Margin="0,0,10,0" />
                <TextBlock Text="{Binding ShownCount, StringFormat='показано: {0}'}"
                           Foreground="#FF80868B" />
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Сохранить как"
                    Style="{StaticResource QuietButton}"
                    Margin="8,0,0,0"
                    Command="{Binding SaveViewAsCommand}" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="#FFE1E4E8" Background="White" Height="30">
                <TextBox Text="{Binding ViewNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Имя, под которым будет сохранён вид" />
            </Border>
        </DockPanel>

        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Categories}"
                  ItemTemplate="{StaticResource NodeTemplate}"
                  ItemContainerStyle="{StaticResource TreeItemStyle}"
                  BorderThickness="0"
                  Background="Transparent"
                  Padding="0,2,0,0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Standard"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" />

    </DockPanel>
</Window>
