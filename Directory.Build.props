<Project>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiDir>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Company>My</Company>
    <Product>View Content Navigator</Product>
    <Copyright>Copyright © $(Company) 2026</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
